# ─────────────────────────────────────────────
#  Servidor MCP de RAGaaS — configuración
# ─────────────────────────────────────────────

# URL del backend RAGaaS (la API de la carpeta Qdrant/).
# Si corre en la misma máquina, dejá este valor.
# (8004 para no chocar con el orchestrator del sistema SAPE, que usa 8000.)
# Usar 127.0.0.1 (no 'localhost'): en Windows 'localhost' resuelve a ::1 (IPv6)
# y el backend bindea en 127.0.0.1 (IPv4) → 'localhost' daría conexión rechazada.
RAGAAS_URL=http://127.0.0.1:8004

# Clave de OpenAI usada para GENERAR la respuesta en la tool 'ask'.
OPENAI_API_KEY=sk-...

# Modelo de chat por defecto.
OPENAI_MODEL=gpt-4o-mini

# Modelo de embeddings (debe coincidir con el que se usó al indexar).
EMBED_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
#  Transporte MCP
# ─────────────────────────────────────────────
# stdio  → el cliente/sistema A2A lanza este script como subproceso (recomendado).
# http   → expone el MCP por red en http://MCP_HOST:MCP_PORT/mcp
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
# 8006: 8080 lo usa búsquedas externas y 8005 está reservado por Windows (winnat).
MCP_PORT=8006
