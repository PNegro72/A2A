# ─────────────────────────────────────────────
#  Qdrant Cloud Configuration
# ─────────────────────────────────────────────
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_api_key_here

# Requerida por src/config.py (os.environ["OPENAI_API_KEY"], fail-fast) para
# generar los embeddings de ingesta/búsqueda. Ver README.md.
OPENAI_API_KEY=<your OpenAI API key>

# Collection names (optional, defaults shown)
QDRANT_COLLECTION=rag_documents
QDRANT_COLLECTION_HYBRID=rag_documents_hybrid

# ─────────────────────────────────────────────
#  Embedding Configuration
# ─────────────────────────────────────────────
# Dense model (sentence-transformers compatible)
# Options: all-MiniLM-L6-v2 (384d), all-mpnet-base-v2 (768d), BAAI/bge-small-en-v1.5 (384d)
DENSE_MODEL=text-embedding-3-small
DENSE_VECTOR_SIZE=1536

# ─────────────────────────────────────────────
#  Chunking Configuration
# ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=80

# ─────────────────────────────────────────────
#  Cache Configuration
# ─────────────────────────────────────────────
ENABLE_CACHE=true
# Cache TTL in seconds (86400 = 24h)
CACHE_TTL=86400

# ─────────────────────────────────────────────
#  Ingestion
# ─────────────────────────────────────────────
BATCH_SIZE=64
