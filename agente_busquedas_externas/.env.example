# ── Langfuse Observabilidad ───────────────────────────────────────────────────
# Obtené las claves en https://us.cloud.langfuse.com (US) o https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Agente Busquedas Externas ---
# LLM configuration (OpenAI via LiteLLM)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=openai/gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# Server configuration
HOST=0.0.0.0
BUSQUEDAS_EXTERNAS_AGENT_PORT=8080
LOG_LEVEL=INFO

# Database
DB_PATH=./agente_busquedas_externas.db

# Source APIs
GITHUB_TOKEN=ghp_...
TAVILY_API_KEY=tvly-...
