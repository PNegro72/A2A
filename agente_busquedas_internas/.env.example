# ── Langfuse Observabilidad ───────────────────────────────────────────────────
# Obtené las claves en https://us.cloud.langfuse.com (US) o https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

CLAUDE_API_KEY=<your Anthropic (Claude) API key>
CLAUDE_MODEL=claude-sonnet-4-6
DEFAULT_TOP_N=10
MAX_TOP_N=20
MAX_CHARS_POR_CV=4000
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# ── MCP RAGaaS (búsqueda de candidatos en Qdrant) ─────────────────────────────
# El agente consume la tool `search` del servidor MCP de la carpeta MCP/.
# Requiere que estén corriendo: (1) el servidor MCP en modo HTTP (:8006)
# y (2) el backend RAGaaS (Qdrant/ → :8004). El start_all.sh levanta ambos.
RAGAAS_MCP_URL=http://127.0.0.1:8006/mcp
RAGAAS_COLLECTION=CVs
RAGAAS_MIN_SCORE=0.0
RAGAAS_CHUNKS_PER_CANDIDATE=5
