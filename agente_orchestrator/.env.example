# ── Langfuse Observabilidad ───────────────────────────────────────────────────
# Obtené las claves en https://us.cloud.langfuse.com (US) o https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

OPENAI_API_KEY=<your OpenAI API key>
OPENAI_MODEL=openai/gpt-4.1
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
HOST=localhost
PORT=8000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4200
# 180s: busquedas_externas corre un pipeline de 7 etapas contra APIs de
# terceros y se midio entre 95s y 152s. Con 120s timeouteaba de forma
# intermitente. Bajalo si preferis fallar rapido antes que esperar.
AGENT_HTTP_TIMEOUT=180
# Presupuesto de tiempo propio por agente, en segundos. Formato:
# "agente:segundos,agente:segundos". Vacio = todos usan AGENT_HTTP_TIMEOUT.
# Sirve para agentes best-effort que tienen que ceder antes que el resto.
AGENT_HTTP_TIMEOUT_OVERRIDES=

# TTL en segundos de los estados de request que respaldan GET /chat/status/{id}.
# Opcional: por defecto 600.
REQUEST_STATE_TTL_SECONDS=600
# Cota de duración de una corrida servida por polling. Si se excede, el cliente
# recibe status=error/RUN_TIMEOUT en lugar de pollear para siempre. Opcional: 600.
RUN_TIMEOUT_SECONDS=600
# Cuánto sobrevive un request_id que nunca fue reclamado por SSE ni por polling.
# Opcional: por defecto 900.
PENDING_TTL_SECONDS=900
SCHEDULING_AGENT_CARD_URL=http://localhost:8004/.well-known/agent.json
BUSQUEDAS_INTERNAS_AGENT_CARD_URL=http://localhost:8002/.well-known/agent.json
BUSQUEDAS_EXTERNAS_AGENT_CARD_URL=http://localhost:8080/.well-known/agent.json
JOB_DESCRIPTION_AGENT_CARD_URL=http://localhost:8001/.well-known/agent.json
ENTREVISTAS_AGENT_CARD_URL=http://localhost:8003/.well-known/agent.json
