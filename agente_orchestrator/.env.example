# ── Langfuse Observabilidad ───────────────────────────────────────────────────
# Obtené las claves en https://us.cloud.langfuse.com (US) o https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

OPENAI_API_KEY=<your OpenAI API key>
OPENAI_MODEL=openai/gpt-4.1
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
HOST=localhost
PORT=8000
AGENT_HTTP_TIMEOUT=120
SCHEDULING_AGENT_CARD_URL=http://localhost:8004/.well-known/agent.json
BUSQUEDAS_INTERNAS_AGENT_CARD_URL=http://localhost:8002/.well-known/agent.json
BUSQUEDAS_EXTERNAS_AGENT_CARD_URL=http://localhost:8080/.well-known/agent.json
JOB_DESCRIPTION_AGENT_CARD_URL=http://localhost:8001/.well-known/agent.json
ENTREVISTAS_AGENT_CARD_URL=http://localhost:8003/.well-known/agent.json
